{
  "$schema": "http://json.schemastore.org/package.json",
  "name": "project_directory_creation",
  "version": "1.3.0",
  "description": "project directory creation tool for Engineering Surveys",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "verify": "node --test \"tests/**/*.test.js\"",
    "verify:build": "node scripts/verify-build.js",
    "smoke": "electron scripts/smoke",
    "e2e": "node scripts/run-e2e.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "npm run verify && cross-env NODE_ENV=production electron-builder --publish never",
    "dist-dev": "cross-env NODE_ENV=development electron-builder --publish never",
    "release:draft": "npm run verify && cross-env NODE_ENV=production electron-builder --publish always",
    "release:publish": "node scripts/publish-release.js",
    "release:publish:check": "node scripts/publish-release.js --dry-run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "algoliasearch": "^4.22.1",
    "archiver": "^7.0.1",
    "electron-log": "^5.1.2",
    "electron-oauth2": "^3.0.0",
    "electron-updater": "^6.1.8",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.2.0",
    "googleapis": "^134.0.0",
    "path": "^0.12.7",
    "xml2js": "^0.6.2"
  },
  "repository": "https://github.com/versy016/Project_Directory_Creation",
  "build": {
    "appId": "com.engsurveys.com.au.projectdirectorycreation",
    "productName": "Project_directory_Creation",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "versy016",
      "repo": "project_directory_creation",
      "releaseType": "draft"
    },
    "files": [
      "**/*",
      "PDIR_Defaults",
      "ACCDIR_Defaults",
      "SyncSettings.ffs_gui",
      "SyncSettings_Quotes.ffs_gui",
      "!**/*.ts",
      "!tests",
      "!docs",
      "!scripts",
      "!*.code-workspace",
      "!README.md",
      "!LICENSE.md",
      "!package.json",
      "!package-lock.json",
      "!tsconfig.json",
      "!tslint.json"
    ],
    "extraFiles": [
      {
        "from": "./SyncSettings_Quotes.ffs_gui",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./SyncSettings.ffs_gui",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./SyncSettingsJdrive.ffs_gui",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": ["nsis","portable"],
      "icon": "pdc.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "pdc.ico",
      "uninstallerIcon": "pdc.ico",
      "installerHeaderIcon": "pdc.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Directory Creation"
    }
  }
}
